<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgDark">#FF09090F</Color>
    <Color x:Key="BgSidebar">#FF0D0F1A</Color>
    <Color x:Key="BgCard">#FF111322</Color>
    <Color x:Key="BgCardHover">#FF16182A</Color>
    <Color x:Key="BgInput">#FF16182A</Color>

    <Color x:Key="BorderColor">#FF2A2D44</Color>
    <Color x:Key="BorderHover">#FF4A4D6A</Color>
    <Color x:Key="BorderInput">#FF2D3150</Color>
    <Color x:Key="BorderFocus">#FF7C6BFF</Color>

    <Color x:Key="Primary">#FF7C6BFF</Color>
    <Color x:Key="PrimaryGlow">#FF6B5DFF</Color>

    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FF9EA3B5</Color>

    <Color x:Key="Success">#FF22C55E</Color>
    <Color x:Key="Error">#FFEF4444</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHover}" />
    <SolidColorBrush x:Key="BorderInputBrush" Color="{StaticResource BorderInput}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />

    <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0A0914" Offset="0" />
        <GradientStop Color="#FF111322" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonButtonBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7C6BFF" Offset="0" />
        <GradientStop Color="#FF6B5DFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0D0F1A" Offset="0" />
        <GradientStop Color="#FF111322" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardGlow" ShadowDepth="0" BlurRadius="30" Color="#7C6BFF" Opacity="0.08" />
    <DropShadowEffect x:Key="CardGlowHover" ShadowDepth="0" BlurRadius="40" Color="#7C6BFF" Opacity="0.15" />
    <DropShadowEffect x:Key="ButtonGlow" ShadowDepth="0" BlurRadius="25" Color="#7C6BFF" Opacity="0.35" />
    <DropShadowEffect x:Key="InputGlow" ShadowDepth="0" BlurRadius="20" Color="#7C6BFF" Opacity="0.25" />
    <DropShadowEffect x:Key="GlowDot" ShadowDepth="0" BlurRadius="8" Color="#22C55E" Opacity="0.5" />

</ResourceDictionary>
